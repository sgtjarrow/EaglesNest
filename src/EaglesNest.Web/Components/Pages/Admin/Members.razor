@page "/admin/members"
@rendermode InteractiveServer

@using EaglesNest.Web.Services.Members
@using EaglesNest.Web.Services.Chapters
@using EaglesNest.Web.Services.Permissions
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

@inject MemberAdminService MemberService
@inject OfficerPermissionService PermissionService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IWebHostEnvironment Environment

<PageTitle>Members</PageTitle>

<h1>Members</h1>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="alert @statusClass alert-dismissible fade show" role="alert">
        @statusMessage
        <button type="button" class="btn-close" aria-label="Close" @onclick="ClearStatus"></button>
    </div>
}

@if (permissions is null)
{
    <p>Loading...</p>
}
else if (!permissions.CanViewMembers)
{
    <div class="alert alert-warning">You do not have permission to view member administration.</div>
}
else
{
<div class="row g-4">
    <section class="col-xl-5">
        <div class="admin-panel">
            <div class="d-flex gap-2 mb-3">
                <input class="form-control" placeholder="Search members" @bind="searchText" @bind:event="oninput" />
                <button type="button" class="btn btn-outline-secondary" @onclick="LoadAsync">Search</button>
                @if (permissions.CanEditMembers)
                {
                    <button type="button" class="btn btn-primary" @onclick="AddMember">Add</button>
                }
            </div>
            <div class="row g-2 mb-3">
                <div class="col-md-7">
                    <select class="form-select" @onchange="OnChapterFilterChangedAsync">
                        <option value="">All chapters</option>
                        @foreach (var chapter in NationalChapterOptions)
                        {
                            <option value="@chapter.Id" selected="@(chapter.Id == filterChapterId)">@chapter.Abbreviation - @chapter.Name</option>
                        }
                        @foreach (var group in FilterChapterOptionGroups)
                        {
                            <optgroup label="@group.Key">
                                @foreach (var chapter in group)
                                {
                                    <option value="@chapter.Id" selected="@(chapter.Id == filterChapterId)">@chapter.Abbreviation - @chapter.Name</option>
                                }
                            </optgroup>
                        }
                    </select>
                </div>
                <div class="col-md-5">
                    <select class="form-select" @onchange="OnStatusFilterChangedAsync">
                        <option value="">All statuses</option>
                        @foreach (var status in MemberOptionValues.Statuses)
                        {
                            <option value="@((int)status)" selected="@(status == filterStatus)">@MemberOptionValues.DisplayStatus(status)</option>
                        }
                    </select>
                </div>
            </div>

            <div class="member-list">
                @if (members.Count == 0)
                {
                    <p class="text-muted mb-0">No members match the current filters.</p>
                }
                else
                {
                    @foreach (var member in members)
                    {
                        var selected = member.Id == selectedMemberId;
                        <button type="button" class="member-row @(selected ? "selected" : null)" @onclick="() => SelectMemberAsync(member.Id)">
                            <span>
                                <strong>@member.DisplayName</strong>
                                <span class="text-muted d-block">@member.LegalName</span>
                            </span>
                            <span class="badge text-bg-light">@member.ChapterAbbreviation</span>
                            <span class="badge @StatusBadgeClass(member.Status)">@MemberOptionValues.DisplayStatus(member.Status)</span>
                        </button>
                    }
                }
            </div>
        </div>
    </section>

    <section class="col-xl-7">
        <div class="admin-panel">
            <h2 class="h4 mb-3">@editorTitle</h2>

            <EditForm Model="editModel" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />

                <ul class="nav nav-tabs" role="tablist">
                    @foreach (var tab in Enum.GetValues<MemberEditorTab>())
                    {
                        <li class="nav-item" role="presentation">
                            <button type="button"
                                    class="nav-link @(activeTab == tab ? "active" : null)"
                                    @onclick="() => activeTab = tab">
                                @DisplayTab(tab)
                            </button>
                        </li>
                    }
                </ul>

                <fieldset disabled="@(!CanEditCurrentMember)">
                <div class="tab-panel">
                    @if (activeTab == MemberEditorTab.Profile)
                    {
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label" for="first-name">First Name</label>
                                <InputText id="first-name" class="form-control" @bind-Value="editModel.FirstName" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="middle-name">Middle Name</label>
                                <InputText id="middle-name" class="form-control" @bind-Value="editModel.MiddleName" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="last-name">Last Name</label>
                                <InputText id="last-name" class="form-control" @bind-Value="editModel.LastName" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="suffix">Suffix</label>
                                <InputText id="suffix" class="form-control" @bind-Value="editModel.Suffix" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="preferred-name">Preferred Name</label>
                                <InputText id="preferred-name" class="form-control" @bind-Value="editModel.PreferredName" />
                            </div>
                            <div class="col-md-5">
                                <label class="form-label" for="road-name">Road Name</label>
                                <InputText id="road-name" class="form-control" @bind-Value="editModel.RoadName" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="dob">Date of Birth</label>
                                <InputDate id="dob" class="form-control" @bind-Value="editModel.DateOfBirth" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="blood-type">Blood Type</label>
                                <InputSelect id="blood-type" class="form-select" @bind-Value="editModel.BloodType">
                                    <option value="">Not entered</option>
                                    @foreach (var bloodType in MemberOptionValues.BloodTypes)
                                    {
                                        <option value="@bloodType">@bloodType</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="gender">Gender</label>
                                <InputSelect id="gender" class="form-select" @bind-Value="editModel.Gender">
                                    <option value="">Not entered</option>
                                    @foreach (var gender in MemberOptionValues.Genders)
                                    {
                                        <option value="@gender">@gender</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="lifetime-date">Lifetime Date</label>
                                <InputDate id="lifetime-date" class="form-control" @bind-Value="editModel.LifetimeDate" />
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="notes">Notes</label>
                                <InputTextArea id="notes" class="form-control" @bind-Value="editModel.Notes" />
                            </div>
                        </div>
                    }
                    else if (activeTab == MemberEditorTab.Contact)
                    {
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" for="email">Member Email</label>
                                <InputText id="email" class="form-control" @bind-Value="editModel.Email" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="phone">Member Phone</label>
                                <InputText id="phone" class="form-control" @bind-Value="editModel.PhoneNumber" />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label" for="address-1">Address Line 1</label>
                                <InputText id="address-1" class="form-control" @bind-Value="editModel.AddressLine1" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="address-2">Address Line 2</label>
                                <InputText id="address-2" class="form-control" @bind-Value="editModel.AddressLine2" />
                            </div>
                            <div class="col-md-5">
                                <label class="form-label" for="city">City</label>
                                <InputText id="city" class="form-control" @bind-Value="editModel.City" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="state">State</label>
                                <InputText id="state" class="form-control text-uppercase" @bind-Value="editModel.State" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="zip">ZIP Code</label>
                                <InputText id="zip" class="form-control" @bind-Value="editModel.PostalCode" />
                            </div>
                        </div>
                    }
                    else if (activeTab == MemberEditorTab.Chapter)
                    {
                        <div class="row g-3">
                            <div class="col-md-7">
                                <label class="form-label" for="primary-chapter">Primary Chapter</label>
                                <InputSelect id="primary-chapter" class="form-select" @bind-Value="editModel.PrimaryChapterId">
                                    <option value="">Select chapter</option>
                                    @foreach (var chapter in PrimaryNationalChapterOptions)
                                    {
                                        <option value="@chapter.Id">@chapter.Abbreviation - @chapter.Name</option>
                                    }
                                    @foreach (var group in PrimaryChapterOptionGroups)
                                    {
                                        <optgroup label="@group.Key">
                                            @foreach (var chapter in group)
                                            {
                                                <option value="@chapter.Id">@chapter.Abbreviation - @chapter.Name</option>
                                            }
                                        </optgroup>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label" for="chapter-effective">Effective Date</label>
                                <InputDate id="chapter-effective" class="form-control" @bind-Value="editModel.ChapterEffectiveDate" />
                            </div>
                            <div class="col-md-7">
                                <label class="form-label" for="linked-account">Linked Login Account</label>
                                <InputSelect id="linked-account" class="form-select" @bind-Value="editModel.ApplicationUserId">
                                    <option value="">No linked login</option>
                                    @foreach (var account in linkedAccountOptions)
                                    {
                                        <option value="@account.Id">@account.UserName (@(account.Email ?? "no email"))</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>

                        @if (chapterAssignments.Count > 0)
                        {
                            <div class="table-responsive log-table mt-3">
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>Chapter</th>
                                            <th>Start</th>
                                            <th>End</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var assignment in chapterAssignments)
                                        {
                                            <tr>
                                                <td>@assignment.ChapterAbbreviation - @assignment.ChapterName</td>
                                                <td>@assignment.StartDate.ToString("yyyy-MM-dd")</td>
                                                <td>@(assignment.EndDate?.ToString("yyyy-MM-dd") ?? "Current")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                    else if (activeTab == MemberEditorTab.Status)
                    {
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label" for="status">Status</label>
                                <InputSelect id="status" class="form-select" @bind-Value="editModel.Status">
                                    @foreach (var status in MemberOptionValues.Statuses)
                                    {
                                        <option value="@status">@MemberOptionValues.DisplayStatus(status)</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="status-effective">Status Effective Date</label>
                                <InputDate id="status-effective" class="form-control" @bind-Value="editModel.StatusEffectiveDate" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="status-notes">Status Notes</label>
                                <InputText id="status-notes" class="form-control" @bind-Value="editModel.StatusNotes" />
                            </div>
                        </div>

                        @if (statusHistory.Count == 0)
                        {
                            <p class="text-muted mt-3 mb-0">No status history yet.</p>
                        }
                        else
                        {
                            <div class="table-responsive log-table mt-3">
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>Status</th>
                                            <th>Effective</th>
                                            <th>Notes</th>
                                            <th>Actor</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var history in statusHistory)
                                        {
                                            <tr>
                                                <td>@MemberOptionValues.DisplayStatus(history.Status)</td>
                                                <td>@history.EffectiveDate.ToString("yyyy-MM-dd")</td>
                                                <td>@(history.Notes ?? string.Empty)</td>
                                                <td>@history.ActorName <span class="text-muted">(@history.ActorSource)</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                    else if (activeTab == MemberEditorTab.MilitaryService)
                    {
                        <div class="d-flex justify-content-end mb-3">
                            @if (CanEditCurrentMember)
                            {
                                <button type="button" class="btn btn-outline-primary" @onclick="AddMilitaryService">Add Service</button>
                            }
                        </div>
                        @if (editModel.MilitaryServiceRecords.Count == 0)
                        {
                            <p class="text-muted mb-0">No military service records entered.</p>
                        }
                        else
                        {
                            @foreach (var record in editModel.MilitaryServiceRecords)
                            {
                                <div class="service-row" @key="record">
                                    <div class="row g-3 align-items-end">
                                        <div class="col-md-3">
                                            <label class="form-label">Branch</label>
                                            <InputSelect class="form-select" @bind-Value="record.Branch">
                                                <option value="">Select branch</option>
                                                @foreach (var branch in MemberOptionValues.Branches)
                                                {
                                                    <option value="@branch">@branch</option>
                                                }
                                            </InputSelect>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label">Rank/Rate</label>
                                            <InputText class="form-control" @bind-Value="record.Rank" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">Start</label>
                                            <InputDate class="form-control" @bind-Value="record.ServiceStartDate" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">End</label>
                                            <InputDate class="form-control" @bind-Value="record.ServiceEndDate" />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label">Discharge Type</label>
                                            <InputSelect class="form-select" @bind-Value="record.DischargeType">
                                                <option value="">Not entered</option>
                                                @foreach (var dischargeType in MemberOptionValues.DischargeTypes)
                                                {
                                                    <option value="@dischargeType">@dischargeType</option>
                                                }
                                            </InputSelect>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label">Conflict Tab</label>
                                            <InputSelect class="form-select" @bind-Value="record.ConflictTab">
                                                <option value="">None</option>
                                                @foreach (var conflictTab in MemberOptionValues.ConflictTabs)
                                                {
                                                    <option value="@conflictTab">@conflictTab</option>
                                                }
                                            </InputSelect>
                                        </div>
                                        <div class="col-md-2">
                                            @if (CanEditCurrentMember)
                                            {
                                                <button type="button" class="btn btn-outline-danger w-100" @onclick="() => RemoveMilitaryService(record)">Remove</button>
                                            }
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label">Notes</label>
                                            <InputText class="form-control" @bind-Value="record.ServiceNotes" />
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    }
                    else if (activeTab == MemberEditorTab.Audit)
                    {
                        @if (auditLogs.Count == 0)
                        {
                            <p class="text-muted mb-0">No audit entries yet.</p>
                        }
                        else
                        {
                            <div class="table-responsive log-table">
                                <table class="table table-sm align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Action</th>
                                            <th>Summary</th>
                                            <th>Actor</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var audit in auditLogs)
                                        {
                                            <tr>
                                                <td class="text-nowrap">@audit.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd h:mm tt")</td>
                                                <td>@DisplayAuditAction(audit.Action)</td>
                                                <td>@audit.Summary</td>
                                                <td>@audit.ActorName <span class="text-muted">(@audit.ActorSource)</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                </div>
                </fieldset>

                <div class="d-flex flex-wrap gap-2 mt-3">
                    @if (CanEditCurrentMember)
                    {
                        <button type="submit" class="btn btn-primary">Save</button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="CancelEditAsync">Cancel</button>
                    }
                </div>
            </EditForm>
        </div>
    </section>
</div>
}

<style>
    .admin-panel {
        border: 1px solid #d8dee4;
        border-radius: 8px;
        padding: 1rem;
        background: #fff;
    }

    .member-list {
        display: grid;
        gap: .25rem;
        max-height: 68vh;
        overflow: auto;
    }

    .member-row {
        display: grid;
        grid-template-columns: minmax(12rem, 1fr) auto auto;
        gap: .5rem;
        align-items: center;
        width: 100%;
        padding: .55rem .75rem;
        border: 1px solid transparent;
        border-radius: 6px;
        background: transparent;
        color: #c6b79b;
        text-align: left;
    }

    .member-row:hover,
    .member-row.selected {
        border-color: #0d6efd;
        background: #eef5ff;
        color: #000;
    }

    .member-row:hover .text-muted,
    .member-row.selected .text-muted {
        color: #111 !important;
    }

    .tab-panel {
        border: 1px solid #dee2e6;
        border-top: 0;
        padding: 1rem;
    }

    .service-row {
        border: 1px solid #dee2e6;
        border-radius: 6px;
        padding: .75rem;
        margin-bottom: .75rem;
    }

    .log-table {
        max-height: 18rem;
        overflow: auto;
    }
</style>

@code {
    private IReadOnlyList<MemberListItem> members = [];
    private IReadOnlyList<ChapterOption> chapterOptions = [];
    private IReadOnlyList<MemberLinkedAccountOption> linkedAccountOptions = [];
    private IReadOnlyList<MemberChapterAssignmentItem> chapterAssignments = [];
    private IReadOnlyList<MemberStatusHistoryItem> statusHistory = [];
    private IReadOnlyList<MemberAuditLogItem> auditLogs = [];
    private OfficerPermissionContext? permissions;
    private MemberEditModel editModel = new();
    private IReadOnlyList<ChapterOption> primaryChapterOptions = [];
    private Guid? selectedMemberId;
    private Guid? filterChapterId;
    private MemberStatus? filterStatus;
    private string? searchText;
    private string? statusMessage;
    private string statusClass = "alert-info";
    private string editorTitle = "Add Member";
    private MemberEditorTab activeTab = MemberEditorTab.Profile;
    private bool CanEditCurrentMember => permissions?.CanEditMemberInChapter(editModel.PrimaryChapterId ?? Guid.Empty) == true;
    private IEnumerable<ChapterOption> NationalChapterOptions => chapterOptions.Where(chapter => IsNationalChapter(chapter.Abbreviation));
    private IEnumerable<ChapterOption> EternalChapterOptions => chapterOptions.Where(chapter => IsEternalChapter(chapter.Abbreviation));
    private IEnumerable<IGrouping<string, ChapterOption>> FilterChapterOptionGroups => chapterOptions
        .Where(chapter => !IsEternalChapter(chapter.Abbreviation) && !IsNationalChapter(chapter.Abbreviation))
        .GroupBy(chapter => chapter.StateName ?? "Other")
        .OrderBy(group => group.Key);
    private IEnumerable<ChapterOption> PrimaryNationalChapterOptions => primaryChapterOptions.Where(chapter => IsNationalChapter(chapter.Abbreviation));
    private IEnumerable<ChapterOption> PrimaryEternalChapterOptions => primaryChapterOptions.Where(chapter => IsEternalChapter(chapter.Abbreviation));
    private IEnumerable<IGrouping<string, ChapterOption>> PrimaryChapterOptionGroups => primaryChapterOptions
        .Where(chapter => !IsEternalChapter(chapter.Abbreviation) && !IsNationalChapter(chapter.Abbreviation))
        .GroupBy(chapter => chapter.StateName ?? "Other")
        .OrderBy(group => group.Key);

    protected override async Task OnInitializedAsync()
    {
        permissions = await GetPermissionsAsync();
        if (!permissions.CanViewMembers)
        {
            return;
        }

        var allChapterOptions = await MemberService.GetChapterOptionsAsync();
        chapterOptions = permissions.CanViewAllMembers
            ? allChapterOptions
            : allChapterOptions.Where(chapter => permissions.CanViewMemberInChapter(chapter.Id)).ToList();
        primaryChapterOptions = permissions.CanEditAllMembers
            ? allChapterOptions
            : allChapterOptions.Where(chapter => permissions.CanEditMemberInChapter(chapter.Id)).ToList();
        linkedAccountOptions = await MemberService.GetLinkableAccountsAsync(null);
        if (permissions.CanEditMembers)
        {
            AddMember();
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (permissions is null || !permissions.CanViewMembers)
        {
            members = [];
            return;
        }

        members = await MemberService.GetMembersAsync(
            searchText,
            filterChapterId,
            filterStatus,
            permissions.ViewMemberChapterIds,
            permissions.CanViewAllMembers);
    }

    private async Task SelectMemberAsync(Guid id)
    {
        var member = await MemberService.GetMemberAsync(id);
        if (member is null)
        {
            ShowError("Member was not found.");
            return;
        }

        if (permissions?.CanViewMemberInChapter(member.PrimaryChapterId ?? Guid.Empty) != true)
        {
            ShowError("You do not have permission to view that member.");
            return;
        }

        selectedMemberId = id;
        editModel = member;
        editorTitle = $"Edit {MemberAdminService.DisplayName(member.FirstName, member.LastName, member.PreferredName, member.RoadName)}";
        linkedAccountOptions = await MemberService.GetLinkableAccountsAsync(editModel.ApplicationUserId);
        chapterAssignments = await MemberService.GetChapterAssignmentsAsync(id);
        statusHistory = await MemberService.GetStatusHistoryAsync(id);
        auditLogs = await MemberService.GetAuditLogsAsync(id);
        ClearStatus();
    }

    private void AddMember()
    {
        if (permissions?.CanEditMembers != true)
        {
            return;
        }

        selectedMemberId = null;
        var defaultChapterId = chapterOptions
            .FirstOrDefault(chapter => primaryChapterOptions.Any(option => option.Id == chapter.Id) && !IsEternalChapter(chapter.Abbreviation))?.Id
            ?? primaryChapterOptions.FirstOrDefault()?.Id;
        editModel = new MemberEditModel
        {
            PrimaryChapterId = defaultChapterId,
            ChapterEffectiveDate = DateOnly.FromDateTime(DateTime.Today),
            StatusEffectiveDate = DateOnly.FromDateTime(DateTime.Today)
        };
        editorTitle = "Add Member";
        chapterAssignments = [];
        statusHistory = [];
        auditLogs = [];
        activeTab = MemberEditorTab.Profile;
        ClearStatus();
    }

    private async Task SaveAsync()
    {
        try
        {
            if (!CanEditCurrentMember)
            {
                ShowError("You do not have permission to edit that member.");
                return;
            }

            var actor = await GetCurrentActorAsync();
            var result = editModel.Id is Guid id
                ? await MemberService.UpdateAsync(id, editModel, actor)
                : await MemberService.CreateAsync(editModel, actor);

            if (!result.Succeeded)
            {
                ShowError(string.Join(" ", result.Errors));
                return;
            }

            await LoadAsync();
            if (result.MemberId is Guid savedId)
            {
                await SelectMemberAsync(savedId);
            }

            ShowSuccess("Member saved.");
        }
        catch (Exception ex)
        {
            ShowError(BuildUnexpectedErrorMessage(ex));
        }
    }

    private async Task CancelEditAsync()
    {
        if (selectedMemberId is Guid id)
        {
            await SelectMemberAsync(id);
        }
        else
        {
            AddMember();
        }
    }

    private void AddMilitaryService()
    {
        editModel.MilitaryServiceRecords.Add(new MilitaryServiceEditModel());
    }

    private void RemoveMilitaryService(MilitaryServiceEditModel record)
    {
        editModel.MilitaryServiceRecords.Remove(record);
    }

    private async Task OnChapterFilterChangedAsync(ChangeEventArgs args)
    {
        filterChapterId = Guid.TryParse(args.Value?.ToString(), out var id) ? id : null;
        await LoadAsync();
    }

    private async Task OnStatusFilterChangedAsync(ChangeEventArgs args)
    {
        filterStatus = int.TryParse(args.Value?.ToString(), out var statusValue)
            ? (MemberStatus)statusValue
            : null;
        await LoadAsync();
    }

    private async Task<MemberActor> GetCurrentActorAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = state.User;
        var userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        var actorName = user.Identity?.Name ?? user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "Unknown User";
        return new MemberActor(userId, actorName, "User");
    }

    private async Task<OfficerPermissionContext> GetPermissionsAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        return await PermissionService.GetPermissionsAsync(userId);
    }

    private static string DisplayTab(MemberEditorTab tab)
    {
        return tab switch
        {
            MemberEditorTab.MilitaryService => "Military Service",
            _ => tab.ToString()
        };
    }

    private static string DisplayAuditAction(AuditAction action)
    {
        return action switch
        {
            AuditAction.MemberUpdated => "Member Updated",
            AuditAction.MemberChapterTransferred => "Chapter Transferred",
            AuditAction.MilitaryServiceAdded => "Military Service Added",
            AuditAction.MilitaryServiceUpdated => "Military Service Updated",
            AuditAction.MilitaryServiceRemoved => "Military Service Removed",
            AuditAction.MemberStatusChanged => "Status Changed",
            AuditAction.RoleAssignmentCreated => "Officer Role Assigned",
            AuditAction.RoleAssignmentRemoved => "Officer Role Removed",
            AuditAction.RoleAssignmentExpired => "Officer Role Expired",
            AuditAction.SystemAdminGranted => "SystemAdmin Granted",
            AuditAction.SystemAdminRemoved => "SystemAdmin Removed",
            _ => action.ToString()
        };
    }

    private static string StatusBadgeClass(MemberStatus status)
    {
        return status switch
        {
            MemberStatus.PatchHolder => "text-bg-success",
            MemberStatus.Prospect or MemberStatus.Probate => "text-bg-info",
            MemberStatus.Suspended => "text-bg-warning",
            MemberStatus.Deceased => "text-bg-dark",
            MemberStatus.Out or MemberStatus.Retired => "text-bg-secondary",
            _ => "text-bg-light"
        };
    }

    private static bool IsEternalChapter(string? abbreviation)
    {
        return ChapterAdminService.IsEternalChapter(abbreviation);
    }

    private static bool IsNationalChapter(string? abbreviation)
    {
        return string.Equals(abbreviation, "NAT", StringComparison.OrdinalIgnoreCase);
    }

    private void ShowSuccess(string message)
    {
        statusMessage = message;
        statusClass = "alert-success";
    }

    private void ShowError(string message)
    {
        statusMessage = message;
        statusClass = "alert-danger";
    }

    private string BuildUnexpectedErrorMessage(Exception ex)
    {
        if (!Environment.IsDevelopment())
        {
            return "An unexpected error occurred while saving the member.";
        }

        var baseException = ex.GetBaseException();
        return $"Unexpected save error: {baseException.GetType().Name}: {baseException.Message}";
    }

    private void ClearStatus()
    {
        statusMessage = null;
        statusClass = "alert-info";
    }

    private enum MemberEditorTab
    {
        Profile,
        Contact,
        Chapter,
        Status,
        MilitaryService,
        Audit
    }
}
