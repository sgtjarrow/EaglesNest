@page "/admin/roles"
@rendermode InteractiveServer

@using EaglesNest.Core.Domain
@using EaglesNest.Web.Services.Chapters
@using EaglesNest.Web.Services.Members
@using EaglesNest.Web.Services.Permissions
@using EaglesNest.Web.Services.Roles
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject OfficerPermissionService PermissionService
@inject RoleAdminService RoleService

<PageTitle>Officer Roles</PageTitle>

<h1>Officer Roles</h1>

@if (permissions is null)
{
    <p>Loading...</p>
}
else if (!permissions.CanManageRoles)
{
    <div class="alert alert-warning">You do not have permission to manage officer roles.</div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert @statusClass alert-dismissible fade show" role="alert">
            @statusMessage
            <button type="button" class="btn-close" aria-label="Close" @onclick="ClearStatus"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-12 col-xl-5">
            <section class="admin-panel">
                <div class="d-flex gap-2 mb-3">
                    <InputText class="form-control" @bind-Value="searchText" placeholder="Search members" />
                    <button type="button" class="btn btn-outline-primary" @onclick="SearchAsync">Search</button>
                </div>

                <div class="role-member-list">
                    @foreach (var member in members)
                    {
                        var selected = member.Id == selectedMemberId;
                        <button type="button" class="role-member-row @(selected ? "selected" : null)" @onclick="() => SelectMemberAsync(member.Id)">
                            <span>
                                <strong>@member.DisplayName</strong>
                                <span class="text-muted d-block">@member.LegalName</span>
                            </span>
                            <span class="badge text-bg-light">@member.ChapterAbbreviation</span>
                            <span class="badge text-bg-success">@member.Status</span>
                        </button>
                    }
                </div>
            </section>
        </div>

        <div class="col-12 col-xl-7">
            @if (permissions.IsSystemAdmin)
            {
                <section class="admin-panel mb-4">
                    <h2 class="h4">SystemAdmin</h2>
                    <p class="text-muted">SystemAdmin is a member flag and is limited to two members.</p>
                    @if (systemAdmins.Count == 0)
                    {
                        <p class="text-muted">No SystemAdmin members assigned.</p>
                    }
                    else
                    {
                        <div class="table-responsive mb-3">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th>Member</th>
                                        <th>Chapter</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var admin in systemAdmins)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@admin.DisplayName</strong>
                                                <span class="text-muted d-block">@admin.LegalName</span>
                                            </td>
                                            <td>@admin.ChapterAbbreviation - @admin.ChapterName</td>
                                            <td class="text-end">
                                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveSystemAdminAsync(admin.Id)">Remove</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    @if (selectedMember is not null)
                    {
                        <button type="button" class="btn btn-outline-primary" @onclick="GrantSystemAdminAsync">Grant Selected Member</button>
                    }
                </section>
            }

            <section class="admin-panel">
                @if (selectedMember is null)
                {
                    <h2 class="h4">Select Member</h2>
                    <p class="text-muted">Choose a member to manage officer assignments.</p>
                }
                else
                {
                    <h2 class="h4">Edit @selectedMember.DisplayName</h2>
                    <p class="text-muted">@selectedMember.LegalName - @selectedMember.ChapterName (@selectedMember.ChapterAbbreviation)</p>

                    <div class="row g-3 align-items-end mb-4">
                        <div class="col-md-5">
                            <label class="form-label" for="position">Officer Position</label>
                            <InputSelect id="position" class="form-select" @bind-Value="selectedPosition">
                                @foreach (var position in PositionOptions)
                                {
                                    <option value="@position">@RoleAdminService.DisplayPosition(position)</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label" for="chapter">Chapter Scope</label>
                            <select id="chapter" class="form-select" @onchange="OnSelectedChapterChangedAsync">
                                @foreach (var chapter in NationalChapterOptions)
                                {
                                    <option class="chapter-option-emphasis" value="@chapter.Id" selected="@(chapter.Id == selectedChapterId)">@chapter.Abbreviation - @chapter.Name</option>
                                }
                                @foreach (var group in ChapterOptionGroups)
                                {
                                    <optgroup label="@group.Key">
                                        @foreach (var chapter in group)
                                        {
                                            <option value="@chapter.Id" selected="@(chapter.Id == selectedChapterId)">@chapter.Abbreviation - @chapter.Name</option>
                                        }
                                    </optgroup>
                                }
                                @foreach (var chapter in EternalChapterOptions)
                                {
                                    <option class="chapter-option-emphasis" value="@chapter.Id" selected="@(chapter.Id == selectedChapterId)">@chapter.Abbreviation - @chapter.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button type="button" class="btn btn-primary w-100" @onclick="AddAssignmentAsync">Add</button>
                        </div>
                    </div>

                    <h3 class="h5">Current Assignments</h3>
                    @if (assignments.Count == 0)
                    {
                        <p class="text-muted">No officer roles assigned.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th>Position</th>
                                        <th>Chapter</th>
                                        <th>Assigned</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var assignment in assignments)
                                    {
                                        <tr>
                                            <td>@RoleAdminService.DisplayPosition(assignment.Position)</td>
                                            <td>@assignment.OrganizationAbbreviation - @assignment.OrganizationName</td>
                                            <td>@assignment.AssignedAt.LocalDateTime.ToString("g")</td>
                                            <td class="text-end">
                                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveAssignmentAsync(assignment.Id)">Remove</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </section>
        </div>
    </div>
}

<style>
    .role-member-list {
        display: grid;
        gap: .25rem;
        max-height: 68vh;
        overflow: auto;
    }

    .role-member-row {
        display: grid;
        grid-template-columns: minmax(12rem, 1fr) auto auto;
        gap: .5rem;
        align-items: center;
        width: 100%;
        padding: .55rem .75rem;
        border: 1px solid transparent;
        border-radius: 6px;
        background: transparent;
        color: #c6b79b;
        text-align: left;
    }

    .role-member-row:hover,
    .role-member-row.selected {
        border-color: #0d6efd;
        background: #eef5ff;
        color: #000;
    }

    .role-member-row:hover .text-muted,
    .role-member-row.selected .text-muted {
        color: #111 !important;
    }

    .chapter-option-emphasis {
        font-weight: 700;
    }
</style>

@code {
    private OfficerPermissionContext? permissions;
    private IReadOnlyList<RoleMemberListItem> members = [];
    private IReadOnlyList<RoleAssignmentItem> assignments = [];
    private IReadOnlyList<RoleChapterOption> chapterOptions = [];
    private IReadOnlyList<RoleMemberListItem> systemAdmins = [];
    private RoleMemberListItem? selectedMember;
    private Guid? selectedMemberId;
    private Guid selectedChapterId;
    private OfficerPosition selectedPosition = OfficerPosition.President;
    private string? searchText;
    private string? statusMessage;
    private string statusClass = "alert-info";

    private IEnumerable<OfficerPosition> PositionOptions =>
        permissions is null ? [] : RoleService.GetAssignablePositions(permissions, selectedChapterId);
    private IEnumerable<RoleChapterOption> NationalChapterOptions => chapterOptions.Where(chapter => IsNationalChapter(chapter.Abbreviation));
    private IEnumerable<RoleChapterOption> EternalChapterOptions => chapterOptions.Where(chapter => IsEternalChapter(chapter.Abbreviation));
    private IEnumerable<IGrouping<string, RoleChapterOption>> ChapterOptionGroups => chapterOptions
        .Where(chapter => !IsNationalChapter(chapter.Abbreviation) && !IsEternalChapter(chapter.Abbreviation))
        .GroupBy(chapter => chapter.StateName ?? "Other")
        .OrderBy(group => group.Key);

    protected override async Task OnInitializedAsync()
    {
        permissions = await GetPermissionsAsync();
        if (!permissions.CanManageRoles)
        {
            return;
        }

        chapterOptions = await RoleService.GetManageableChapterOptionsAsync(permissions);
        selectedChapterId = chapterOptions.FirstOrDefault()?.Id ?? Guid.Empty;
        selectedPosition = PositionOptions.FirstOrDefault();
        systemAdmins = await RoleService.GetSystemAdminsAsync();
        await SearchAsync();
    }

    private async Task SearchAsync()
    {
        if (permissions is null)
        {
            return;
        }

        members = await RoleService.SearchMembersAsync(searchText, permissions);
    }

    private async Task SelectMemberAsync(Guid memberId)
    {
        selectedMemberId = memberId;
        selectedMember = members.SingleOrDefault(member => member.Id == memberId);
        assignments = await RoleService.GetAssignmentsAsync(memberId);

        selectedChapterId = chapterOptions.FirstOrDefault(chapter => chapter.Abbreviation == selectedMember?.ChapterAbbreviation)?.Id
            ?? chapterOptions.FirstOrDefault()?.Id
            ?? Guid.Empty;
        selectedPosition = PositionOptions.FirstOrDefault();
    }

    private Task OnSelectedChapterChangedAsync(ChangeEventArgs args)
    {
        selectedChapterId = Guid.TryParse(args.Value?.ToString(), out var chapterId)
            ? chapterId
            : Guid.Empty;
        if (!PositionOptions.Contains(selectedPosition))
        {
            selectedPosition = PositionOptions.FirstOrDefault();
        }

        return Task.CompletedTask;
    }

    private async Task AddAssignmentAsync()
    {
        if (permissions is null || selectedMemberId is null || selectedChapterId == Guid.Empty)
        {
            return;
        }

        var result = await RoleService.AddAssignmentAsync(selectedMemberId.Value, selectedPosition, selectedChapterId, permissions, await BuildActorAsync());
        await AfterSaveAsync(result);
    }

    private async Task RemoveAssignmentAsync(Guid assignmentId)
    {
        if (permissions is null)
        {
            return;
        }

        var result = await RoleService.RemoveAssignmentAsync(assignmentId, permissions, await BuildActorAsync());
        await AfterSaveAsync(result);
    }

    private async Task GrantSystemAdminAsync()
    {
        if (permissions is null || selectedMemberId is null)
        {
            return;
        }

        var result = await RoleService.GrantSystemAdminAsync(selectedMemberId.Value, permissions, await BuildActorAsync());
        await AfterSaveAsync(result);
        systemAdmins = await RoleService.GetSystemAdminsAsync();
    }

    private async Task RemoveSystemAdminAsync(Guid memberId)
    {
        if (permissions is null)
        {
            return;
        }

        var result = await RoleService.RemoveSystemAdminAsync(memberId, permissions, await BuildActorAsync());
        await AfterSaveAsync(result);
        systemAdmins = await RoleService.GetSystemAdminsAsync();
    }

    private async Task AfterSaveAsync(RoleSaveResult result)
    {
        statusClass = result.Succeeded ? "alert-success" : "alert-danger";
        statusMessage = result.Succeeded ? "Officer role assignments updated." : string.Join(" ", result.Errors);

        if (selectedMemberId is not null)
        {
            assignments = await RoleService.GetAssignmentsAsync(selectedMemberId.Value);
        }
    }

    private void ClearStatus()
    {
        statusMessage = null;
    }

    private async Task<OfficerPermissionContext> GetPermissionsAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        return await PermissionService.GetPermissionsAsync(userId);
    }

    private async Task<MemberActor> BuildActorAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = state.User;
        var userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        var actorName = user.Identity?.Name ?? user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "Unknown User";
        return new MemberActor(userId, actorName, "User");
    }

    private static bool IsNationalChapter(string? abbreviation)
    {
        return string.Equals(abbreviation, "NAT", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsEternalChapter(string? abbreviation)
    {
        return ChapterAdminService.IsEternalChapter(abbreviation);
    }
}
