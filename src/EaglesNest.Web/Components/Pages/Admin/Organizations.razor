@page "/admin/organizations"
@rendermode InteractiveServer

@using EaglesNest.Core.Domain
@using EaglesNest.Web.Services.Organizations
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

@inject OrganizationAdminService OrganizationService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Organizations</PageTitle>

<h1>Organizations</h1>

<div class="d-flex flex-wrap gap-2 align-items-center mb-3">
    <button type="button" class="btn btn-primary" @onclick="AddNational" disabled="@HasNational">Add National</button>
    <button type="button" class="btn btn-outline-primary" @onclick="AddState" disabled="@(!CanAddState)">Add State</button>
    <button type="button" class="btn btn-outline-primary" @onclick="AddChapter" disabled="@(!CanAddChapter)">Add Chapter</button>
</div>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="alert @statusClass" role="alert">@statusMessage</div>
}

<div class="row g-4">
    <section class="col-xl-5">
        <div class="admin-panel">
            <div class="d-flex gap-2 align-items-center mb-3">
                <input class="form-control" placeholder="Search organizations" @bind="SearchText" @bind:event="oninput" />
                <span class="badge text-bg-secondary">@displayRows.Count</span>
            </div>

            <div class="organization-list" role="tree">
                @if (displayRows.Count == 0)
                {
                    <p class="text-muted mb-0">No organizations match the current search.</p>
                }
                else
                {
                    @foreach (var row in displayRows)
                    {
                        var selected = row.Item.Id == selectedOrganizationId;
                        <button type="button"
                                class="organization-row @(selected ? "selected" : null) @(row.Item.IsActive ? null : "inactive")"
                                style="--indent:@row.Depth"
                                @onclick="() => SelectOrganization(row.Item.Id)">
                            <span class="organization-name">@row.Item.Name</span>
                            <span class="badge text-bg-light">@row.Item.Abbreviation</span>
                            <span class="organization-meta">@row.Item.Level</span>
                            @if (!row.Item.IsActive)
                            {
                                <span class="badge text-bg-warning">Inactive</span>
                            }
                        </button>
                    }
                }
            </div>
        </div>
    </section>

    <section class="col-xl-7">
        <div class="admin-panel">
            <h2 class="h4 mb-3">@editorTitle</h2>

            <EditForm Model="editModel" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />

                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label" for="org-name">Name</label>
                        <InputText id="org-name" class="form-control" @bind-Value="editModel.Name" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="org-abbreviation">Abbreviation</label>
                        <InputText id="org-abbreviation" class="form-control text-uppercase" @bind-Value="editModel.Abbreviation" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="org-level">Level</label>
                        <InputSelect id="org-level" class="form-select" @bind-Value="editModel.Level">
                            <option value="@OrganizationLevel.National">National</option>
                            <option value="@OrganizationLevel.State">State</option>
                            <option value="@OrganizationLevel.LocalChapter">Local Chapter</option>
                        </InputSelect>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="org-parent">Parent</label>
                        <InputSelect id="org-parent" class="form-select" @bind-Value="editModel.ParentOrganizationUnitId" disabled="@(editModel.Level == OrganizationLevel.National)">
                            <option value="">None</option>
                            @foreach (var parent in parentOptions.Where(IsAllowedParent))
                            {
                                <option value="@parent.Id">@parent.Abbreviation - @parent.Name</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label" for="org-city">City</label>
                        <InputText id="org-city" class="form-control" @bind-Value="editModel.City" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="org-state-code">State Code</label>
                        <InputText id="org-state-code" class="form-control text-uppercase" @bind-Value="editModel.StateCode" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="org-charter">Charter Number</label>
                        <InputText id="org-charter" class="form-control" @bind-Value="editModel.CharterNumber" />
                    </div>
                    <div class="col-12">
                        <div class="form-check form-switch">
                            <InputCheckbox id="org-active" class="form-check-input" @bind-Value="editModel.IsActive" disabled="@(editModel.Level == OrganizationLevel.National)" />
                            <label class="form-check-label" for="org-active">Active</label>
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit">Cancel</button>
                    @if (editModel.Id is not null && editModel.Level != OrganizationLevel.National)
                    {
                        <button type="button" class="btn btn-outline-warning" @onclick="ToggleActiveAsync">
                            @(editModel.IsActive ? "Deactivate" : "Reactivate")
                        </button>
                    }
                    @if (canDelete)
                    {
                        <button type="button" class="btn btn-outline-danger" @onclick="DeleteAsync">Delete</button>
                    }
                </div>
            </EditForm>
        </div>
    </section>
</div>

<style>
    .admin-panel {
        border: 1px solid #d8dee4;
        border-radius: 8px;
        padding: 1rem;
        background: #fff;
    }

    .organization-list {
        display: grid;
        gap: .25rem;
        max-height: 68vh;
        overflow: auto;
    }

    .organization-row {
        display: grid;
        grid-template-columns: minmax(10rem, 1fr) auto auto auto;
        gap: .5rem;
        align-items: center;
        width: 100%;
        padding: .55rem .75rem .55rem calc(.75rem + (var(--indent) * 1.25rem));
        border: 1px solid transparent;
        border-radius: 6px;
        background: transparent;
        text-align: left;
    }

    .organization-row:hover,
    .organization-row.selected {
        border-color: #0d6efd;
        background: #eef5ff;
    }

    .organization-row.inactive {
        opacity: .62;
    }

    .organization-name {
        font-weight: 600;
    }

    .organization-meta {
        color: #6c757d;
        font-size: .875rem;
    }
</style>

@code {
    private IReadOnlyList<OrganizationTreeItem> hierarchy = [];
    private IReadOnlyList<OrganizationTreeItem> parentOptions = [];
    private List<OrganizationDisplayRow> displayRows = [];
    private OrganizationEditModel editModel = new();
    private Guid? selectedOrganizationId;
    private string? statusMessage;
    private string statusClass = "alert-info";
    private string? searchText;
    private bool canDelete;
    private string editorTitle = "Select or add an organization";

    private string? SearchText
    {
        get => searchText;
        set
        {
            searchText = value;
            RefreshDisplayRows();
        }
    }

    private bool HasNational => hierarchy.Any(item => item.Level == OrganizationLevel.National);
    private bool CanAddState => selectedOrganizationId is null || SelectedItem?.Level == OrganizationLevel.National;
    private bool CanAddChapter => SelectedItem?.Level == OrganizationLevel.State;
    private OrganizationTreeItem? SelectedItem => FindItem(hierarchy, selectedOrganizationId);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        var first = hierarchy.FirstOrDefault();
        if (first is not null)
        {
            await SelectOrganization(first.Id);
        }
    }

    private async Task LoadAsync()
    {
        hierarchy = await OrganizationService.GetHierarchyAsync();
        parentOptions = await OrganizationService.GetParentOptionsAsync();
        RefreshDisplayRows();
    }

    private void RefreshDisplayRows()
    {
        displayRows = [];
        foreach (var root in hierarchy)
        {
            AddDisplayRows(root, 0);
        }
    }

    private void AddDisplayRows(OrganizationTreeItem item, int depth)
    {
        if (!MatchesSearchTree(item))
        {
            return;
        }

        displayRows.Add(new OrganizationDisplayRow(item, depth));
        foreach (var child in item.Children)
        {
            AddDisplayRows(child, depth + 1);
        }
    }

    private bool MatchesSearchTree(OrganizationTreeItem item)
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            return true;
        }

        return MatchesSearch(item) || item.Children.Any(MatchesSearchTree);
    }

    private bool MatchesSearch(OrganizationTreeItem item)
    {
        var text = searchText?.Trim();
        if (string.IsNullOrWhiteSpace(text))
        {
            return true;
        }

        return Contains(item.Name, text)
            || Contains(item.Abbreviation, text)
            || Contains(item.City, text)
            || Contains(item.StateCode, text);
    }

    private static bool Contains(string? value, string text)
    {
        return value?.Contains(text, StringComparison.OrdinalIgnoreCase) == true;
    }

    private async Task SelectOrganization(Guid id)
    {
        var organization = await OrganizationService.GetOrganizationAsync(id);
        if (organization is null)
        {
            ShowError("Organization was not found.");
            return;
        }

        selectedOrganizationId = id;
        editModel = organization;
        editorTitle = $"Edit {organization.Abbreviation}";
        canDelete = await OrganizationService.CanDeleteAsync(id);
        ClearStatus();
    }

    private void AddNational()
    {
        selectedOrganizationId = null;
        editModel = new OrganizationEditModel
        {
            Level = OrganizationLevel.National,
            Name = "National",
            Abbreviation = "NAT",
            IsActive = true
        };
        editorTitle = "Add National";
        canDelete = false;
        ClearStatus();
    }

    private void AddState()
    {
        var national = hierarchy.FirstOrDefault(item => item.Level == OrganizationLevel.National);
        selectedOrganizationId = null;
        editModel = new OrganizationEditModel
        {
            Level = OrganizationLevel.State,
            ParentOrganizationUnitId = national?.Id,
            IsActive = true
        };
        editorTitle = "Add State";
        canDelete = false;
        ClearStatus();
    }

    private void AddChapter()
    {
        if (SelectedItem?.Level != OrganizationLevel.State)
        {
            ShowError("Select a State before adding a local chapter.");
            return;
        }

        selectedOrganizationId = null;
        editModel = new OrganizationEditModel
        {
            Level = OrganizationLevel.LocalChapter,
            ParentOrganizationUnitId = SelectedItem.Id,
            StateCode = SelectedItem.StateCode,
            IsActive = true
        };
        editorTitle = $"Add Chapter under {SelectedItem.Abbreviation}";
        canDelete = false;
        ClearStatus();
    }

    private async Task SaveAsync()
    {
        var userId = await GetCurrentUserIdAsync();
        var result = editModel.Id is Guid id
            ? await OrganizationService.UpdateAsync(id, editModel, userId)
            : await OrganizationService.CreateAsync(editModel, userId);

        if (!result.Succeeded)
        {
            ShowError(string.Join(" ", result.Errors));
            return;
        }

        await LoadAsync();
        if (result.OrganizationId is Guid savedId)
        {
            await SelectOrganization(savedId);
        }
        ShowSuccess("Organization saved.");
    }

    private async Task ToggleActiveAsync()
    {
        if (editModel.Id is not Guid id)
        {
            return;
        }

        var result = await OrganizationService.SetActiveAsync(id, !editModel.IsActive, await GetCurrentUserIdAsync());
        if (!result.Succeeded)
        {
            ShowError(string.Join(" ", result.Errors));
            return;
        }

        await LoadAsync();
        await SelectOrganization(id);
        ShowSuccess(editModel.IsActive ? "Organization reactivated." : "Organization deactivated.");
    }

    private async Task DeleteAsync()
    {
        if (editModel.Id is not Guid id)
        {
            return;
        }

        var result = await OrganizationService.DeleteAsync(id, await GetCurrentUserIdAsync());
        if (!result.Succeeded)
        {
            ShowError(string.Join(" ", result.Errors));
            return;
        }

        await LoadAsync();
        var first = hierarchy.FirstOrDefault();
        if (first is not null)
        {
            await SelectOrganization(first.Id);
        }
        else
        {
            editModel = new();
            selectedOrganizationId = null;
            editorTitle = "Select or add an organization";
        }
        ShowSuccess("Organization deleted.");
    }

    private async Task CancelEdit()
    {
        if (selectedOrganizationId is Guid id)
        {
            await SelectOrganization(id);
        }
        else
        {
            editModel = new();
            editorTitle = "Select or add an organization";
            ClearStatus();
        }
    }

    private bool IsAllowedParent(OrganizationTreeItem item)
    {
        if (editModel.Id == item.Id)
        {
            return false;
        }

        return editModel.Level switch
        {
            OrganizationLevel.State => item.Level == OrganizationLevel.National,
            OrganizationLevel.LocalChapter => item.Level == OrganizationLevel.State,
            _ => false
        };
    }

    private async Task<string?> GetCurrentUserIdAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    }

    private static OrganizationTreeItem? FindItem(IEnumerable<OrganizationTreeItem> items, Guid? id)
    {
        if (id is null)
        {
            return null;
        }

        foreach (var item in items)
        {
            if (item.Id == id)
            {
                return item;
            }

            var child = FindItem(item.Children, id);
            if (child is not null)
            {
                return child;
            }
        }

        return null;
    }

    private void ShowSuccess(string message)
    {
        statusMessage = message;
        statusClass = "alert-success";
    }

    private void ShowError(string message)
    {
        statusMessage = message;
        statusClass = "alert-danger";
    }

    private void ClearStatus()
    {
        statusMessage = null;
        statusClass = "alert-info";
    }

    private sealed record OrganizationDisplayRow(OrganizationTreeItem Item, int Depth);
}
