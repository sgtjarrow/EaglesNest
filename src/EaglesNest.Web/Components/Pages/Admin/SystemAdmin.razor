@page "/admin/system-admin"
@rendermode InteractiveServer

@using EaglesNest.Web.Services
@using EaglesNest.Web.Services.Members
@using EaglesNest.Web.Services.Permissions
@using EaglesNest.Web.Services.Roles
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject OfficerPermissionService PermissionService
@inject RoleAdminService RoleService
@inject AuditActorResolver ActorResolver

<PageTitle>SystemAdmin</PageTitle>

<h1>SystemAdmin</h1>

@if (permissions is null)
{
    <p>Loading...</p>
}
else if (!permissions.IsSystemAdmin)
{
    <div class="alert alert-warning">You do not have permission to manage SystemAdmin members.</div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert @statusClass alert-dismissible fade show" role="alert">
            @statusMessage
            <button type="button" class="btn-close" aria-label="Close" @onclick="ClearStatus"></button>
        </div>
    }

    <div class="row g-4">
        <section class="col-12 col-xl-5">
            <div class="admin-panel">
                <div class="d-flex gap-2 mb-3">
                    <InputText class="form-control" @bind-Value="searchText" placeholder="Search members" />
                    <button type="button" class="btn btn-outline-primary" @onclick="SearchAsync">Search</button>
                </div>

                <div class="system-admin-member-list">
                    @if (members.Count == 0)
                    {
                        <p class="text-muted mb-0">No members match the current search.</p>
                    }
                    else
                    {
                        @foreach (var member in members)
                        {
                            var selected = member.Id == selectedMemberId;
                            <button type="button" class="system-admin-member-row @(selected ? "selected" : null)" @onclick="() => SelectMember(member)">
                                <span>
                                    <strong>@member.DisplayName</strong>
                                    <span class="text-muted d-block">@member.LegalName</span>
                                </span>
                                <span class="badge text-bg-light">@member.ChapterAbbreviation</span>
                                <span class="badge text-bg-success">@member.Status</span>
                            </button>
                        }
                    }
                </div>
            </div>
        </section>

        <section class="col-12 col-xl-7">
            <div class="admin-panel">
                <h2 class="h4">Current SystemAdmins</h2>
                <p class="text-muted">SystemAdmin is limited to two members.</p>
                @if (systemAdmins.Count == 0)
                {
                    <p class="text-muted">No SystemAdmin members assigned.</p>
                }
                else
                {
                    <div class="table-responsive mb-3">
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th>Member</th>
                                    <th>Chapter</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var admin in systemAdmins)
                                {
                                    <tr>
                                        <td>
                                            <strong>@admin.DisplayName</strong>
                                            <span class="text-muted d-block">@admin.LegalName</span>
                                        </td>
                                        <td>@admin.ChapterAbbreviation - @admin.ChapterName</td>
                                        <td class="text-end">
                                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveSystemAdminAsync(admin.Id)">Remove</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <h3 class="h5">Grant SystemAdmin</h3>
                @if (selectedMember is null)
                {
                    <p class="text-muted mb-0">Select a member to grant SystemAdmin.</p>
                }
                else
                {
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span>
                            <strong>@selectedMember.DisplayName</strong>
                            <span class="text-muted">(@selectedMember.ChapterAbbreviation)</span>
                        </span>
                        <button type="button" class="btn btn-outline-primary" @onclick="GrantSystemAdminAsync">Grant Selected Member</button>
                    </div>
                }
            </div>
        </section>
    </div>
}

<style>
    .system-admin-member-list {
        display: grid;
        gap: .25rem;
        max-height: 68vh;
        overflow: auto;
    }

    .system-admin-member-row {
        display: grid;
        grid-template-columns: minmax(12rem, 1fr) auto auto;
        gap: .5rem;
        align-items: center;
        width: 100%;
        padding: .55rem .75rem;
        border: 1px solid transparent;
        border-radius: 6px;
        background: transparent;
        color: #c6b79b;
        text-align: left;
    }

    .system-admin-member-row:hover,
    .system-admin-member-row.selected {
        border-color: #0d6efd;
        background: #eef5ff;
        color: #000;
    }

    .system-admin-member-row:hover .text-muted,
    .system-admin-member-row.selected .text-muted {
        color: #111 !important;
    }
</style>

@code {
    private OfficerPermissionContext? permissions;
    private IReadOnlyList<RoleMemberListItem> members = [];
    private IReadOnlyList<RoleMemberListItem> systemAdmins = [];
    private RoleMemberListItem? selectedMember;
    private Guid? selectedMemberId;
    private string? searchText;
    private string? statusMessage;
    private string statusClass = "alert-info";

    protected override async Task OnInitializedAsync()
    {
        permissions = await GetPermissionsAsync();
        if (!permissions.IsSystemAdmin)
        {
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (permissions is null)
        {
            return;
        }

        systemAdmins = await RoleService.GetSystemAdminsAsync();
        await SearchAsync();
    }

    private async Task SearchAsync()
    {
        if (permissions is null)
        {
            return;
        }

        members = await RoleService.SearchMembersAsync(searchText, permissions);
    }

    private void SelectMember(RoleMemberListItem member)
    {
        selectedMember = member;
        selectedMemberId = member.Id;
    }

    private async Task GrantSystemAdminAsync()
    {
        if (permissions is null || selectedMemberId is null)
        {
            return;
        }

        var result = await RoleService.GrantSystemAdminAsync(selectedMemberId.Value, permissions, await BuildActorAsync());
        await AfterSaveAsync(result);
    }

    private async Task RemoveSystemAdminAsync(Guid memberId)
    {
        if (permissions is null)
        {
            return;
        }

        var result = await RoleService.RemoveSystemAdminAsync(memberId, permissions, await BuildActorAsync());
        await AfterSaveAsync(result);
    }

    private async Task AfterSaveAsync(RoleSaveResult result)
    {
        statusClass = result.Succeeded ? "alert-success" : "alert-danger";
        statusMessage = result.Succeeded ? "SystemAdmin assignments updated." : string.Join(" ", result.Errors);
        systemAdmins = await RoleService.GetSystemAdminsAsync();
        await SearchAsync();
    }

    private void ClearStatus()
    {
        statusMessage = null;
    }

    private async Task<OfficerPermissionContext> GetPermissionsAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        return await PermissionService.GetPermissionsAsync(userId);
    }

    private async Task<MemberActor> BuildActorAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return await ActorResolver.ResolveMemberActorAsync(state.User);
    }
}
