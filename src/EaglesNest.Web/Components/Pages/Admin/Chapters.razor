@page "/admin/chapters"
@rendermode InteractiveServer

@using EaglesNest.Core.Domain
@using EaglesNest.Web.Services.Chapters
@using EaglesNest.Web.Services.Permissions
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

@inject ChapterAdminService ChapterService
@inject OfficerPermissionService PermissionService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Chapters</PageTitle>

<h1>Chapters</h1>

@if (permissions is null)
{
    <p>Loading...</p>
}
else if (!permissions.CanEditAnyChapter)
{
    <div class="alert alert-warning">You do not have permission to edit chapter administration.</div>
}
else
{
<div class="d-flex flex-wrap gap-2 align-items-center justify-content-end mb-3">
    <div class="form-check form-switch">
        <input id="include-unavailable"
               class="form-check-input"
               type="checkbox"
               checked="@includeUnavailable"
               @onchange="OnIncludeUnavailableChangedAsync" />
        <label class="form-check-label" for="include-unavailable">Include closed/suspended</label>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="alert @statusClass alert-dismissible fade show" role="alert">
        @statusMessage
        <button type="button" class="btn-close" aria-label="Close" @onclick="DismissStatus"></button>
    </div>
}

<div class="row g-4">
    <section class="col-xl-5">
        <div class="admin-panel">
            <div class="d-flex gap-2 align-items-center mb-3">
                <input class="form-control" placeholder="Search chapters" @bind="SearchText" @bind:event="oninput" />
                <span class="badge text-bg-secondary">@displayRows.Count</span>
            </div>

            <div class="chapter-list" role="tree">
                @if (displayRows.Count == 0)
                {
                    <p class="text-muted mb-0">No chapters match the current search.</p>
                }
                else
                {
                    @foreach (var row in displayRows)
                    {
                        var selected = row.Item.Id == selectedChapterId;
                        <button type="button"
                                class="chapter-row @(selected ? "selected" : null) @(row.Item.Status == OrganizationStatus.Open ? null : "unavailable") @(IsEmphasizedChapterRow(row.Item) ? "emphasized" : null)"
                                style="--indent:@row.Depth"
                                @onclick="() => SelectChapter(row.Item.Id)">
                            <span class="chapter-name">@row.Item.Name</span>
                            <span class="badge text-bg-light">@row.Item.Abbreviation</span>
                            @if (row.Item.Level != OrganizationLevel.LocalChapter)
                            {
                                <span class="chapter-meta">@DisplayLevel(row.Item.Level)</span>
                            }
                            @if (row.Item.Status != OrganizationStatus.Open)
                            {
                                <span class="badge @StatusBadgeClass(row.Item.Status)">@row.Item.Status</span>
                            }
                            @if (row.Item.Level == OrganizationLevel.State &&
                                                    row.Item.Status == OrganizationStatus.Open &&
                                                    row.Item.ActingStateChapterAbbreviation is not null)
                            {
                                <span class="chapter-meta state-assignment">@row.Item.ActingStateChapterAbbreviation</span>
                            }
                        </button>
                    }
                }
            </div>
        </div>
    </section>

    <section class="col-xl-7">
        <div class="admin-panel">
            <h2 class="h4 mb-3">@editorTitle</h2>

            @if (IsExistingStateGrouping)
            {
                @if (CanAddChapterUnderSelectedState)
                {
                    <div class="d-flex justify-content-end mb-3">
                        <button type="button" class="btn btn-outline-primary" @onclick="AddChapter">Add Chapter</button>
                    </div>
                }
                <dl class="row mb-0">
                    <dt class="col-sm-4">Name</dt>
                    <dd class="col-sm-8">@editModel.Name</dd>
                    <dt class="col-sm-4">Abbreviation</dt>
                    <dd class="col-sm-8">@editModel.Abbreviation</dd>
                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8"><span class="badge @StatusBadgeClass(editModel.Status)">@editModel.Status</span></dd>
                </dl>
            }
            else
            {
                <EditForm Model="editModel" OnValidSubmit="SaveAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" />

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label" for="org-name">Name</label>
                            <InputText id="org-name" class="form-control" @bind-Value="editModel.Name" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="org-abbreviation">Abbreviation</label>
                            <InputText id="org-abbreviation" class="form-control" @bind-Value="editModel.Abbreviation" />
                        </div>
                        @if (ShowCityStateFields)
                        {
                            <div class="col-md-5">
                                <label class="form-label" for="org-city">City</label>
                                <InputText id="org-city" class="form-control" @bind-Value="editModel.City" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="org-state-code">State Code</label>
                                <InputText id="org-state-code" class="form-control text-uppercase" @bind-Value="editModel.StateCode" />
                            </div>
                        }
                        <div class="col-md-4">
                            <label class="form-label" for="org-charter-date">Charter Date</label>
                            <InputDate id="org-charter-date" class="form-control" @bind-Value="editModel.CharterDate" />
                        </div>
                        @if (ShowMailingFields)
                        {
                            <div class="col-12">
                                <h3 class="h6 mb-0 mt-2">Mailing Address</h3>
                            </div>
                            <div class="col-md-8">
                                <label class="form-label" for="org-mailing-address-1">Address Line 1</label>
                                <InputText id="org-mailing-address-1" class="form-control" @bind-Value="editModel.MailingAddressLine1" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="org-mailing-address-2">Address Line 2</label>
                                <InputText id="org-mailing-address-2" class="form-control" @bind-Value="editModel.MailingAddressLine2" />
                            </div>
                            <div class="col-md-5">
                                <label class="form-label" for="org-mailing-city">City</label>
                                <InputText id="org-mailing-city" class="form-control" @bind-Value="editModel.MailingCity" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="org-mailing-state">State</label>
                                <InputText id="org-mailing-state" class="form-control text-uppercase" @bind-Value="editModel.MailingStateCode" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="org-mailing-postal">ZIP Code</label>
                                <InputText id="org-mailing-postal" class="form-control" @bind-Value="editModel.MailingPostalCode" />
                            </div>
                        }
                        <div class="col-12">
                            <span class="badge @StatusBadgeClass(editModel.Status)">Status: @editModel.Status</span>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-4">
                        @if (CanEditSelectedChapter)
                        {
                            <button type="submit" class="btn btn-primary">Save</button>
                        }
                        @if (editModel.Id is not null && editModel.Level == OrganizationLevel.National && permissions?.CanEditAllChapters == true)
                        {
                            <button type="button" class="btn btn-outline-primary" @onclick="AddState">Add State</button>
                        }
                        <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit">Cancel</button>
                        @if (CanCloseOrReopenSelected)
                        {
                            @if (editModel.Status == OrganizationStatus.Closed)
                            {
                                <button type="button" class="btn btn-outline-success" @onclick="ReopenAsync">Reopen</button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-outline-warning" @onclick="CloseAsync">Close</button>
                            }
                        }
                        @if (CanEndSuspensionSelected)
                        {
                            <button type="button" class="btn btn-outline-success" @onclick="EndSuspensionAsync">End Suspension</button>
                        }
                    </div>
                </EditForm>
            }

            @if (editModel.Id is not null)
            {
                <hr />
                <ul class="nav nav-tabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button type="button"
                                class="nav-link @(activeLogTab == ChapterLogTab.Audit ? "active" : null)"
                                @onclick="() => activeLogTab = ChapterLogTab.Audit">
                            Audit Log
                        </button>
                    </li>
                    @if (ShowStateAssignmentTab)
                    {
                        <li class="nav-item" role="presentation">
                            <button type="button"
                                    class="nav-link @(activeLogTab == ChapterLogTab.StateAssignment ? "active" : null)"
                                    @onclick="() => activeLogTab = ChapterLogTab.StateAssignment">
                                State Assignment
                            </button>
                        </li>
                    }
                    @if (ShowSuspensionTab)
                    {
                        <li class="nav-item" role="presentation">
                            <button type="button"
                                    class="nav-link @(activeLogTab == ChapterLogTab.Suspension ? "active" : null)"
                                    @onclick="() => activeLogTab = ChapterLogTab.Suspension">
                                Suspension
                            </button>
                        </li>
                    }
                </ul>
                <div class="log-tab-panel">
                    @if (activeLogTab == ChapterLogTab.Audit)
                    {
                        @if (auditLogs.Count == 0)
                        {
                            <p class="text-muted mb-0">No audit entries yet.</p>
                        }
                        else
                        {
                            <div class="table-responsive log-table">
                                <table class="table table-sm align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Action</th>
                                            <th>Summary</th>
                                            <th>Actor</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var audit in auditLogs)
                                        {
                                            <tr>
                                                <td class="text-nowrap">@audit.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd h:mm tt")</td>
                                                <td>@DisplayAuditAction(audit.Action)</td>
                                                <td>@audit.Summary</td>
                                                <td>@audit.ActorName <span class="text-muted">(@audit.ActorSource)</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                    else if (activeLogTab == ChapterLogTab.StateAssignment)
                    {
                        <h3 class="h6">Acting State Chapter</h3>
                        <div class="row g-3 align-items-end">
                            <div class="col-md-5">
                                <label class="form-label" for="state-chapter">Chapter</label>
                                <InputSelect id="state-chapter" class="form-select" @bind-Value="selectedStateChapterId">
                                    <option value="">Select chapter</option>
                                    @foreach (var chapter in stateChapterOptions)
                                    {
                                        <option value="@chapter.Id">@chapter.Abbreviation - @chapter.Name</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="state-chapter-start">Start Date</label>
                                <InputDate id="state-chapter-start" class="form-control" @bind-Value="stateChapterStart" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="state-chapter-notes">Notes</label>
                                <InputText id="state-chapter-notes" class="form-control" @bind-Value="stateChapterNotes" />
                            </div>
                            <div class="col-12">
                                @if (permissions?.CanEditAllChapters == true)
                                {
                                    <button type="button" class="btn btn-outline-primary" @onclick="AssignStateChapterAsync">Assign State Chapter</button>
                                }
                            </div>
                        </div>

                        @if (stateAssignments.Count > 0)
                        {
                            <div class="table-responsive log-table mt-3">
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>Chapter</th>
                                            <th>Start</th>
                                            <th>End</th>
                                            <th>Notes</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var assignment in stateAssignments)
                                        {
                                            <tr>
                                                <td>@assignment.LocalChapterAbbreviation - @assignment.LocalChapterName</td>
                                                <td>@assignment.StartsOn.ToString("yyyy-MM-dd")</td>
                                                <td>@(assignment.EndsOn?.ToString("yyyy-MM-dd") ?? "Current")</td>
                                                <td>@assignment.Notes</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                    else if (activeLogTab == ChapterLogTab.Suspension)
                    {
                        @if (currentSuspension is not null)
                        {
                            <div class="alert alert-warning">
                                Current suspension started @currentSuspension.StartsOn.ToString("yyyy-MM-dd").
                                @if (currentSuspension.EndsOn is not null)
                                {
                                    <span>Planned end: @currentSuspension.EndsOn.Value.ToString("yyyy-MM-dd").</span>
                                }
                            </div>
                        }

                        @if (CanSuspendSelected)
                        {
                            <h3 class="h6">Suspend Chapter</h3>
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label" for="suspension-start">Start Date</label>
                                    <InputDate id="suspension-start" class="form-control" @bind-Value="suspensionStart" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="suspension-end">Planned End Date</label>
                                    <InputDate id="suspension-end" class="form-control" @bind-Value="suspensionEnd" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="suspension-notes">Notes</label>
                                    <InputText id="suspension-notes" class="form-control" @bind-Value="suspensionNotes" />
                                </div>
                                <div class="col-12">
                                    <button type="button" class="btn btn-outline-warning" @onclick="SuspendAsync">Suspend</button>
                                </div>
                            </div>
                        }
                    }
                </div>
            }
        </div>
    </section>
</div>
}

<style>
    .admin-panel {
        border: 1px solid #d8dee4;
        border-radius: 8px;
        padding: 1rem;
        background: #fff;
    }

    .chapter-list {
        display: grid;
        gap: .25rem;
        max-height: 68vh;
        overflow: auto;
    }

    .chapter-row {
        display: grid;
        grid-template-columns: minmax(10rem, 1fr) auto auto auto;
        gap: .5rem;
        align-items: center;
        width: 100%;
        padding: .55rem .75rem .55rem calc(.75rem + (var(--indent) * 1.25rem));
        border: 1px solid transparent;
        border-radius: 6px;
        background: transparent;
        color: #c6b79b;
        text-align: left;
    }

    .chapter-row:hover,
    .chapter-row.selected {
        border-color: #0d6efd;
        background: #eef5ff;
        color: #000;
    }

    .chapter-row.unavailable {
        opacity: .68;
    }

    .chapter-name {
        font-weight: 500;
    }

    .chapter-row.emphasized .chapter-name {
        font-weight: 700;
    }

    .chapter-meta {
        color: #a99a80;
        font-size: .875rem;
    }

    .chapter-row:hover .chapter-meta,
    .chapter-row.selected .chapter-meta {
        color: #111;
    }

    .state-assignment {
        white-space: nowrap;
    }

    .log-tab-panel {
        border: 1px solid #dee2e6;
        border-top: 0;
        padding: 1rem;
    }

    .log-table {
        max-height: 18rem;
        overflow: auto;
    }
</style>

@code {
    private IReadOnlyList<ChapterTreeItem> hierarchy = [];
    private IReadOnlyList<ChapterTreeItem> stateChapterOptions = [];
    private IReadOnlyList<StateChapterAssignmentModel> stateAssignments = [];
    private IReadOnlyList<ChapterAuditLogItem> auditLogs = [];
    private List<ChapterDisplayRow> displayRows = [];
    private ChapterEditModel editModel = new();
    private OfficerPermissionContext? permissions;
    private ChapterSuspension? currentSuspension;
    private Guid? selectedChapterId;
    private Guid? selectedStateChapterId;
    private string? statusMessage;
    private string statusClass = "alert-info";
    private string? searchText;
    private string editorTitle = "Select or add a chapter";
    private DateOnly suspensionStart = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly? suspensionEnd;
    private string? suspensionNotes;
    private DateOnly stateChapterStart = DateOnly.FromDateTime(DateTime.Today);
    private string? stateChapterNotes;
    private Guid? pendingNewStateId;
    private bool creatingFirstChapterForNewState;
    private bool includeUnavailable;
    private ChapterLogTab activeLogTab = ChapterLogTab.Audit;

    private string? SearchText
    {
        get => searchText;
        set
        {
            searchText = value;
            RefreshDisplayRows();
        }
    }

    private async Task OnIncludeUnavailableChangedAsync(ChangeEventArgs args)
    {
        includeUnavailable = args.Value is bool value && value;
        await LoadAsync();
    }

    private ChapterTreeItem? SelectedItem => FindItem(hierarchy, selectedChapterId);
    private bool IsExistingStateGrouping => editModel.Id is not null && editModel.Level == OrganizationLevel.State;
    private bool IsEternalChapter => ChapterAdminService.IsEternalChapter(editModel.Abbreviation);
    private bool ShowCityStateFields => editModel.Level == OrganizationLevel.LocalChapter && !IsEternalChapter;
    private bool ShowMailingFields => (editModel.Level == OrganizationLevel.National || editModel.Level == OrganizationLevel.LocalChapter) && !IsEternalChapter;
    private bool CanCloseOrReopenSelected => editModel.Id is not null &&
                                             permissions?.CanEditChapter(editModel.Id.Value) == true &&
                                             editModel.Level != OrganizationLevel.National &&
                                             !IsEternalChapter;
    private bool CanSuspendSelected => editModel.Id is not null &&
                                       permissions?.CanEditChapter(editModel.Id.Value) == true &&
                                       editModel.Level == OrganizationLevel.LocalChapter &&
                                       editModel.Status == OrganizationStatus.Open &&
                                       !IsEternalChapter;
    private bool CanEndSuspensionSelected => editModel.Id is not null &&
                                             permissions?.CanEditChapter(editModel.Id.Value) == true &&
                                             editModel.Level == OrganizationLevel.LocalChapter &&
                                             editModel.Status == OrganizationStatus.Suspended &&
                                             !IsEternalChapter;
    private bool ShowStateAssignmentTab => editModel.Id is not null && editModel.Level == OrganizationLevel.State;
    private bool ShowSuspensionTab => currentSuspension is not null || CanSuspendSelected || CanEndSuspensionSelected;
    private bool CanEditSelectedChapter => editModel.Id is Guid id
        ? permissions?.CanEditChapter(id) == true
        : editModel.Level == OrganizationLevel.State
            ? permissions?.CanEditAllChapters == true
            : editModel.ParentOrganizationUnitId is Guid parentId && permissions?.CanEditAllChapters == true;
    private bool CanAddChapterUnderSelectedState => IsExistingStateGrouping && permissions?.CanEditAllChapters == true;

    protected override async Task OnInitializedAsync()
    {
        permissions = await GetPermissionsAsync();
        if (!permissions.CanEditAnyChapter)
        {
            return;
        }

        await LoadAsync();
        var first = displayRows.FirstOrDefault(row => row.Item.Level == OrganizationLevel.LocalChapter && permissions.CanEditChapter(row.Item.Id))?.Item
            ?? displayRows.FirstOrDefault(row => permissions.CanEditChapter(row.Item.Id))?.Item
            ?? hierarchy.FirstOrDefault();
        if (first is not null)
        {
            await SelectChapter(first.Id);
        }
    }

    private async Task LoadAsync()
    {
        hierarchy = await ChapterService.GetHierarchyAsync(includeUnavailable);
        RefreshDisplayRows();
    }

    private void RefreshDisplayRows()
    {
        displayRows = [];
        foreach (var root in hierarchy)
        {
            AddDisplayRows(root, 0);
        }
    }

    private void AddDisplayRows(ChapterTreeItem item, int depth)
    {
        if (!MatchesSearchTree(item))
        {
            return;
        }

        displayRows.Add(new ChapterDisplayRow(item, depth));
        foreach (var child in item.Children)
        {
            AddDisplayRows(child, depth + 1);
        }
    }

    private bool MatchesSearchTree(ChapterTreeItem item)
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            return true;
        }

        return MatchesSearch(item) || item.Children.Any(MatchesSearchTree);
    }

    private bool MatchesSearch(ChapterTreeItem item)
    {
        var text = searchText?.Trim();
        if (string.IsNullOrWhiteSpace(text))
        {
            return true;
        }

        return Contains(item.Name, text)
            || Contains(item.Abbreviation, text)
            || Contains(item.City, text)
            || Contains(item.StateCode, text)
            || Contains(item.MailingCity, text)
            || Contains(item.MailingStateCode, text);
    }

    private static bool Contains(string? value, string text)
    {
        return value?.Contains(text, StringComparison.OrdinalIgnoreCase) == true;
    }

    private async Task SelectChapter(Guid id)
    {
        var organization = await ChapterService.GetChapterAsync(id);
        if (organization is null)
        {
            ShowError("Chapter was not found.");
            return;
        }

        if (organization.Level != OrganizationLevel.State && permissions?.CanEditChapter(id) != true)
        {
            ShowError("You do not have permission to edit that chapter.");
            return;
        }

        selectedChapterId = id;
        editModel = organization;
        editorTitle = organization.Level == OrganizationLevel.State
            ? $"{organization.Name} State"
            : $"Edit {organization.Abbreviation}";
        currentSuspension = organization.Status == OrganizationStatus.Suspended
            ? await ChapterService.GetCurrentSuspensionAsync(id)
            : null;
        await LoadStateAssignmentDetailsAsync(id, organization.Level);
        auditLogs = await ChapterService.GetChapterAuditLogsAsync(id);
        EnsureActiveLogTabIsValid();
        ClearStatus();
    }

    private async Task LoadStateAssignmentDetailsAsync(Guid id, OrganizationLevel level)
    {
        selectedStateChapterId = null;
        stateChapterOptions = [];
        stateAssignments = [];
        if (level != OrganizationLevel.State)
        {
            return;
        }

        stateChapterOptions = await ChapterService.GetLocalChapterOptionsAsync(id);
        stateAssignments = await ChapterService.GetStateChapterAssignmentsAsync(id);
        selectedStateChapterId = stateAssignments.FirstOrDefault(assignment => assignment.EndsOn is null)?.LocalChapterOrganizationUnitId;
    }

    private void AddState()
    {
        if (permissions?.CanEditAllChapters != true)
        {
            ShowError("You do not have permission to add States.");
            return;
        }

        var national = hierarchy.FirstOrDefault(item => item.Level == OrganizationLevel.National);
        selectedChapterId = null;
        editModel = new ChapterEditModel
        {
            Level = OrganizationLevel.State,
            ParentOrganizationUnitId = national?.Id,
            Status = OrganizationStatus.Open
        };
        editorTitle = "Add State";
        currentSuspension = null;
        auditLogs = [];
        activeLogTab = ChapterLogTab.Audit;
        pendingNewStateId = null;
        creatingFirstChapterForNewState = false;
        ClearStatus();
    }

    private void AddChapter()
    {
        var selectedState = SelectedItem;
        if (selectedState?.Level != OrganizationLevel.State)
        {
            ShowError("Select a State before adding a chapter.");
            return;
        }

        if (!CanAddChapterUnderSelectedState)
        {
            ShowError("You do not have permission to add chapters.");
            return;
        }

        selectedChapterId = null;
        editModel = new ChapterEditModel
        {
            Level = OrganizationLevel.LocalChapter,
            ParentOrganizationUnitId = selectedState.Id,
            StateCode = selectedState.StateCode,
            Status = OrganizationStatus.Open
        };
        editorTitle = $"Add Chapter Under {selectedState.Name}";
        currentSuspension = null;
        auditLogs = [];
        activeLogTab = ChapterLogTab.Audit;
        creatingFirstChapterForNewState = pendingNewStateId == selectedState.Id;
        ClearStatus();
    }

    private async Task SaveAsync()
    {
        if (!CanEditSelectedChapter)
        {
            ShowError("You do not have permission to save that chapter.");
            return;
        }

        var actor = await GetCurrentActorAsync();
        var wasCreatingState = editModel.Id is null && editModel.Level == OrganizationLevel.State;
        var wasCreatingFirstChapter = editModel.Id is null &&
                                      editModel.Level == OrganizationLevel.LocalChapter &&
                                      creatingFirstChapterForNewState &&
                                      pendingNewStateId is Guid pendingStateId &&
                                      editModel.ParentOrganizationUnitId == pendingStateId;
        var result = editModel.Id is Guid id
            ? await ChapterService.UpdateAsync(id, editModel, actor)
            : await ChapterService.CreateAsync(editModel, actor);

        if (!result.Succeeded)
        {
            ShowError(string.Join(" ", result.Errors));
            return;
        }

        if (wasCreatingState && result.ChapterId is Guid newStateId)
        {
            pendingNewStateId = newStateId;
            await LoadAsync();
            await SelectChapter(newStateId);
            AddChapter();
            ShowSuccess("State saved. Add the first chapter to finish setup.");
            return;
        }

        if (wasCreatingFirstChapter &&
            result.ChapterId is Guid newChapterId &&
            pendingNewStateId is Guid stateId)
        {
            var assignmentResult = await ChapterService.AssignStateChapterAsync(
                stateId,
                newChapterId,
                DateOnly.FromDateTime(DateTime.Today),
                "Automatically assigned as first chapter for new State.",
                actor);

            if (!assignmentResult.Succeeded)
            {
                ShowError(string.Join(" ", assignmentResult.Errors));
                return;
            }

            pendingNewStateId = null;
            creatingFirstChapterForNewState = false;
        }

        await LoadAsync();
        if (result.ChapterId is Guid savedId)
        {
            await SelectChapter(savedId);
        }
        ShowSuccess("Chapter saved.");
    }

    private async Task CloseAsync()
    {
        if (editModel.Id is not Guid id)
        {
            return;
        }

        if (permissions?.CanEditChapter(id) != true)
        {
            ShowError("You do not have permission to close that chapter.");
            return;
        }

        var result = await ChapterService.CloseAsync(id, await GetCurrentActorAsync());
        await HandleStatusResultAsync(result, "Chapter closed.");
    }

    private async Task ReopenAsync()
    {
        if (editModel.Id is not Guid id)
        {
            return;
        }

        if (permissions?.CanEditChapter(id) != true)
        {
            ShowError("You do not have permission to reopen that chapter.");
            return;
        }

        var result = await ChapterService.ReopenAsync(id, await GetCurrentActorAsync());
        await HandleStatusResultAsync(result, "Chapter reopened.");
    }

    private async Task SuspendAsync()
    {
        if (editModel.Id is not Guid id)
        {
            return;
        }

        if (permissions?.CanEditChapter(id) != true)
        {
            ShowError("You do not have permission to suspend that chapter.");
            return;
        }

        var result = await ChapterService.SuspendAsync(id, suspensionStart, suspensionEnd, suspensionNotes, await GetCurrentActorAsync());
        await HandleStatusResultAsync(result, "Chapter suspended.");
    }

    private async Task EndSuspensionAsync()
    {
        if (editModel.Id is not Guid id)
        {
            return;
        }

        if (permissions?.CanEditChapter(id) != true)
        {
            ShowError("You do not have permission to end that suspension.");
            return;
        }

        var result = await ChapterService.EndSuspensionAsync(id, DateOnly.FromDateTime(DateTime.Today), await GetCurrentActorAsync());
        await HandleStatusResultAsync(result, "Suspension ended.");
    }

    private async Task AssignStateChapterAsync()
    {
        if (editModel.Id is not Guid stateId || selectedStateChapterId is not Guid chapterId)
        {
            ShowError("Select a chapter before assigning the acting State chapter.");
            return;
        }

        if (permissions?.CanEditAllChapters != true)
        {
            ShowError("You do not have permission to assign acting State chapters.");
            return;
        }

        var result = await ChapterService.AssignStateChapterAsync(stateId, chapterId, stateChapterStart, stateChapterNotes, await GetCurrentActorAsync());
        await HandleStatusResultAsync(result, "Acting State chapter updated.");
    }

    private async Task HandleStatusResultAsync(ChapterSaveResult result, string successMessage)
    {
        if (!result.Succeeded)
        {
            ShowError(string.Join(" ", result.Errors));
            return;
        }

        await LoadAsync();
        if (result.ChapterId is Guid id)
        {
            if (!includeUnavailable)
            {
                includeUnavailable = true;
                await LoadAsync();
            }

            await SelectChapter(id);
        }
        ShowSuccess(successMessage);
    }

    private async Task CancelEdit()
    {
        if (creatingFirstChapterForNewState && pendingNewStateId is Guid stateId)
        {
            var result = await ChapterService.AbandonEmptyStateAsync(stateId);
            pendingNewStateId = null;
            creatingFirstChapterForNewState = false;
            await LoadAsync();

            if (!result.Succeeded)
            {
                ShowError(string.Join(" ", result.Errors));
                return;
            }

            var national = hierarchy.FirstOrDefault(item => item.Level == OrganizationLevel.National);
            if (national is not null)
            {
                await SelectChapter(national.Id);
            }
            else
            {
                editModel = new();
                editorTitle = "Select or add a chapter";
            }

            ShowSuccess("New State setup canceled.");
            return;
        }

        if (selectedChapterId is Guid id)
        {
            await SelectChapter(id);
        }
        else
        {
            editModel = new();
            editorTitle = "Select or add a chapter";
            auditLogs = [];
            activeLogTab = ChapterLogTab.Audit;
            ClearStatus();
        }
    }

    private async Task<ChapterActor> GetCurrentActorAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = state.User;
        var userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        var actorName = user.Identity?.Name ?? user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "Unknown User";
        return new ChapterActor(userId, actorName, "User");
    }

    private async Task<OfficerPermissionContext> GetPermissionsAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        return await PermissionService.GetPermissionsAsync(userId);
    }

    private static ChapterTreeItem? FindItem(IEnumerable<ChapterTreeItem> items, Guid? id)
    {
        if (id is null)
        {
            return null;
        }

        foreach (var item in items)
        {
            if (item.Id == id)
            {
                return item;
            }

            var child = FindItem(item.Children, id);
            if (child is not null)
            {
                return child;
            }
        }

        return null;
    }

    private static string DisplayLevel(OrganizationLevel level)
    {
        return level == OrganizationLevel.LocalChapter ? "Local" : level.ToString();
    }

    private static bool IsEmphasizedChapterRow(ChapterTreeItem chapter)
    {
        return chapter.Level is OrganizationLevel.National or OrganizationLevel.State ||
               ChapterAdminService.IsEternalChapter(chapter.Abbreviation);
    }

    private static string StatusBadgeClass(OrganizationStatus status)
    {
        return status switch
        {
            OrganizationStatus.Open => "text-bg-success",
            OrganizationStatus.Suspended => "text-bg-warning",
            OrganizationStatus.Closed => "text-bg-secondary",
            _ => "text-bg-light"
        };
    }

    private static string DisplayAuditAction(AuditAction action)
    {
        return action switch
        {
            AuditAction.MemberAdded => "Member Added",
            AuditAction.MemberRemoved => "Member Removed",
            AuditAction.MemberUpdated => "Member Updated",
            _ => action.ToString()
        };
    }

    private void EnsureActiveLogTabIsValid()
    {
        if (activeLogTab == ChapterLogTab.StateAssignment && !ShowStateAssignmentTab)
        {
            activeLogTab = ChapterLogTab.Audit;
        }

        if (activeLogTab == ChapterLogTab.Suspension && !ShowSuspensionTab)
        {
            activeLogTab = ChapterLogTab.Audit;
        }
    }

    private void ShowSuccess(string message)
    {
        statusMessage = message;
        statusClass = "alert-success";
    }

    private void ShowError(string message)
    {
        statusMessage = message;
        statusClass = "alert-danger";
    }

    private void ClearStatus()
    {
        statusMessage = null;
        statusClass = "alert-info";
    }

    private void DismissStatus()
    {
        ClearStatus();
    }

    private sealed record ChapterDisplayRow(ChapterTreeItem Item, int Depth);

    private enum ChapterLogTab
    {
        Audit,
        StateAssignment,
        Suspension
    }
}
