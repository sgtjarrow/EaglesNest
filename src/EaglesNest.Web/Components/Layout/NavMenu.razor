@implements IDisposable

@using EaglesNest.Web.Services.Members
@using EaglesNest.Web.Services.Permissions

@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject MemberAdminService MemberService
@inject OfficerPermissionService PermissionService

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Eagle's Nest</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                @if (permissions?.CanAccessAdmin == true)
                {
                    <div class="nav-item px-3 mt-2 text-uppercase text-light opacity-75 small">
                        Admin
                    </div>
                    @if (permissions.CanEditAnyChapter)
                    {
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="admin/chapters">
                                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Chapters
                            </NavLink>
                        </div>
                    }
                    @if (permissions.CanViewMembers)
                    {
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="admin/members">
                                <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> Members
                            </NavLink>
                        </div>
                    }
                    @if (permissions.CanManageRoles)
                    {
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="admin/roles">
                                <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> Roles
                            </NavLink>
                        </div>
                    }
                    @if (permissions.IsSystemAdmin)
                    {
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="admin/system-admin">
                                <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> SystemAdmin
                            </NavLink>
                        </div>
                    }
                }
            </Authorized>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3 mt-2 text-uppercase text-light opacity-75 small">
                    Member Profile
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="member/profile">
                        <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> @(memberProfileLabel ?? "Member Profile")
                    </NavLink>
                </div>
                <div class="nav-item px-3 mt-2 text-uppercase text-light opacity-75 small">
                    Account Profile
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Manage">
                        <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> @context.User.Identity?.Name
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="nav-link">
                            <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> Logout
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Register">
                        <span class="bi bi-person-nav-menu" aria-hidden="true"></span> Register
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> Login
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private string? currentUrl;
    private string? memberProfileLabel;
    private OfficerPermissionContext? permissions;

    protected override async Task OnInitializedAsync()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (!string.IsNullOrWhiteSpace(userId))
        {
            memberProfileLabel = await MemberService.GetMemberProfileLabelAsync(userId);
            permissions = await PermissionService.GetPermissionsAsync(userId);
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}

