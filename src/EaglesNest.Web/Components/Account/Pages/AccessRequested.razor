@page "/Account/AccessRequested"

<PageTitle>Access requested</PageTitle>

<div class="auth-shell">
    <section class="auth-card status-card">
        <span class="status-mark" aria-hidden="true">✓</span>
        <p class="eyebrow">Request received</p>
        <h1>Awaiting approval</h1>
        <p>Your account is secure but inactive. An administrator must approve your request before you can sign in.</p>
        <a class="btn-secondary-wide" href="Account/Login">Return to sign in</a>
    </section>
</div>
